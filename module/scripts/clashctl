#!/system/bin/sh
# clashctl - KSU Clash 控制命令
# 用法: clashctl {start|stop|restart|reload|toggle|status|mode|enable|disable|resume|log|version|panel|watchdog}

. /data/adb/modules/ksuclash/scripts/common.sh

START_WAIT=25   # 秒，等待核心就绪

cleanup_stop() {
    $BB rm -f "$PID_FILE" 2>/dev/null
    set_tile off
}

stop_watchdog() {
    [ -f "$WDPID_FILE" ] && {
        _w=$(cat "$WDPID_FILE" 2>/dev/null)
        [ -n "$_w" ] && kill "$_w" 2>/dev/null
        $BB rm -f "$WDPID_FILE"
    }
}

do_stop() {
    _p=$(core_pid)
    if [ "$_p" = "-1" ]; then
        cleanup_stop
        return 0
    fi
    set_tile stopping
    kill "$_p" 2>/dev/null
    _i=0
    while [ $_i -lt 50 ]; do
        kill -0 "$_p" 2>/dev/null || break
        sleep 0.1 2>/dev/null || sleep 1
        _i=$((_i + 1))
        [ $_i -eq 10 ] && kill "$_p" 2>/dev/null
        [ $_i -eq 40 ] && kill -9 "$_p" 2>/dev/null
    done
    kill -9 "$_p" 2>/dev/null
    cleanup_stop
    log "core stopped (pid $_p)"
    return 0
}

# 生成 runtime.yaml（仅当用户配置比 runtime 新或 runtime 不存在）
build_runtime() {
    _need=1
    if [ -f "$RUNTIME_CFG" ] && [ -f "$USER_CFG" ]; then
        [ "$USER_CFG" -nt "$RUNTIME_CFG" ] && _need=1 || _need=0
    fi
    if [ "$_need" = "1" ]; then
        sh "$SCR_DIR/patch_config.sh" || return 1
    fi
    [ -f "$RUNTIME_CFG" ]
}

# 校验配置；失败时回退：先试当前 runtime，再试"原始配置直跑"
validate() {
    _out=$("$BIN_DIR/mihomo" -d "$DATA_DIR" -t -f "$RUNTIME_CFG" 2>&1)
    if [ $? -eq 0 ]; then
        return 0
    fi
    $BB echo "$_out" | tail -5 >> "$LOG_FILE" 2>/dev/null
    log "config test FAILED: $(echo "$_out" | tail -1)"
    return 1
}

do_start() {
    ensure_dirs
    if [ -f "$PANIC_FILE" ]; then
        echo "panic: 看门狗熔断中（$(cat "$PANIC_FILE" 2>/dev/null)）"
        echo "如确认已修复请执行: clashctl resume"
        return 1
    fi
    if is_running; then
        echo "already running (pid $(core_pid))"
        return 0
    fi
    if [ ! -f "$USER_CFG" ]; then
        $BB cp -f "$MODDIR/config.default.yaml" "$USER_CFG" 2>/dev/null
        echo "未找到用户配置，已生成默认模板: $USER_CFG （请填入你的节点）"
    fi
    [ -f "$ENABLED_FILE" ] || $BB echo 1 > "$ENABLED_FILE"

    build_runtime || { echo "runtime 生成失败，见 module.log"; return 1; }
    validate || { echo "配置校验失败（mihomo -t），见日志尾"; return 1; }
    rotate_log

    set_tile starting
    nohup "$BIN_DIR/mihomo" -d "$DATA_DIR" -f "$RUNTIME_CFG" >> "$LOG_FILE" 2>&1 < /dev/null &
    _pid=$!
    $BB echo "$_pid" > "$PID_FILE" 2>/dev/null

    # 等待 API 与 tun 就绪
    _i=0
    _ok=""
    while [ $_i -lt $START_WAIT ]; do
        sleep 1
        kill -0 "$_pid" 2>/dev/null || break
        _code=$(api_code GET /version 2>/dev/null)
        case "$_code" in *200*) _ok=1; break ;; esac
        _i=$((_i + 1))
    done

    if [ -z "$_ok" ] || ! kill -0 "$_pid" 2>/dev/null; then
        $BB echo "start FAILED at $($_i + 1)s, pid=$_pid" >> "$LOG_FILE"
        log "start failed: process exited during readiness wait"
        kill -9 "$_pid" 2>/dev/null
        cleanup_stop
        echo "启动失败（详见 $LOG_FILE 尾部）"
        return 1
    fi

    set_tile on
    log "core started (pid $_pid), api ready after $((_i + 1))s"

    # 根因防御：脱离 App freezer cgroup（经管理器 su 启动时 mihomo 会继承管理器的
    # uid_xxx 冻结组；系统后台冻结该组时隧道整体黑洞）。移入 system 组（不受冻结）。
    [ -f /sys/fs/cgroup/system/cgroup.procs ] && \
        $BB echo "$_pid" > /sys/fs/cgroup/system/cgroup.procs 2>/dev/null
    # v1 控制器尽力迁移（老内核兜底）
    for _f in /dev/cpuset/top-app/tasks /dev/cpuset/tasks; do
        [ -w "$_f" ] && $BB echo "$_pid" > "$_f" 2>/dev/null
    done

    # 启动看门狗（独立进程）
    stop_watchdog
    nohup sh "$SCR_DIR/watchdog.sh" > /dev/null 2>&1 < /dev/null &
    $BB echo $! > "$WDPID_FILE" 2>/dev/null

    echo "running (pid $_pid)"
    return 0
}

# 生成 zashboard 参数化直登 URL（zashboard 支持 ?hostname&port&secret&protocol 自动导入并登录）
panel_url() {
    _s=$(get_secret)
    _enc=$(printf '%s' "$_s" | $BB sed \
        -e 's/%/%25/g' -e 's/ /%20/g' -e 's/&/%26/g' -e 's/#/%23/g' \
        -e 's/?/%3F/g' -e 's/@/%40/g' -e 's/:/%3A/g' -e 's|/|%2F|g' \
        -e 's/=/%3D/g')
    _h="${API_ADDR%%:*}"
    _p="${API_ADDR##*:}"
    case "$_h" in
        0.0.0.0|"*"|"::"|"[::]") _h="127.0.0.1" ;;
    esac
    $BB echo "http://$_h:$_p/ui/?hostname=$_h&port=$_p&protocol=http&secret=$_enc&label=KSUClash#/setup"
}

do_status() {
    _p=$(core_pid)
    _tile="off"
    [ -f "$TILE_FILE" ] && _tile=$(cat "$TILE_FILE" 2>/dev/null)
    [ -f "$PANIC_FILE" ] && _tile="panic"
    _ver=$(api GET /version 2>/dev/null | head -1)
    _mode=""
    [ -n "$_ver" ] && _mode=$(api GET /configs 2>/dev/null | grep -o '"mode":"[a-z]*"' | head -1)
    _tun="-"
    if $BB ls /sys/class/net 2>/dev/null | $BB grep -qiE '^(Meta|mihomo)$'; then _tun="up"; fi
    echo "state=$_tile pid=$_p tun=$_tun"
    echo "api=${_ver:-unreachable} ${_mode}"
    echo "panel=$(panel_url)"
    [ -f "$PANIC_FILE" ] && echo "panic=$(cat "$PANIC_FILE")"
    return 0
}

do_mode() {
    _m="$1"
    case "$_m" in
        rule|global|direct) ;;
        "") echo "usage: clashctl mode rule|global|direct"; return 1 ;;
        *) echo "invalid mode: $_m"; return 1 ;;
    esac
    _code=$(api_code PATCH /configs "{\"mode\":\"$_m\"}")
    case "$_code" in
        *204*|*200*) echo "mode -> $_m" ;;
        *) echo "mode switch failed: ${_code:-no api}"; return 1 ;;
    esac
}

case "$1" in
    start)    do_start ;;
    stop)     do_stop; echo "stopped" ;;
    restart)  do_stop; sleep 1; do_start ;;
    reload)
        _p=$(core_pid)
        if [ "$_p" = "-1" ]; then echo "not running"; exit 1; fi
        build_runtime && { kill -HUP "$_p" && echo "reloaded (SIGHUP)"; } || echo "runtime 生成失败"
        ;;
    toggle)
        if [ -f "$PANIC_FILE" ]; then
            do_stop 2>/dev/null; $BB rm -f "$PANIC_FILE" "$CRASH_FILE"; echo "panic 已清除"
        fi
        if is_running; then
            do_stop; $BB echo 0 > "$ENABLED_FILE"; echo "stopped"
        else
            $BB echo 1 > "$ENABLED_FILE"
            do_start
        fi
        ;;
    resume)   $BB rm -f "$PANIC_FILE" "$CRASH_FILE"; $BB echo 1 > "$ENABLED_FILE"; do_start ;;
    enable)   $BB rm -f "$PANIC_FILE" "$CRASH_FILE"; $BB echo 1 > "$ENABLED_FILE"; echo "autostart on" ;;
    disable)  $BB echo 0 > "$ENABLED_FILE"; do_stop; echo "autostart off, stopped" ;;
    mode)     shift; do_mode "$@" ;;
    status)   do_status ;;
    log)      tail ${2:--50} "$LOG_FILE" 2>/dev/null ;;
    mlog)     tail ${2:--50} "$DATA_DIR/module.log" 2>/dev/null ;;
    version)  "$BIN_DIR/mihomo" -v 2>/dev/null | head -1 ;;
    panel)    panel_url ;;
    watchdog) sh "$SCR_DIR/watchdog.sh" "$@" ;;
    *)
        echo "KSU Clash (mihomo) 控制命令"
        echo "  start|stop|restart|reload|toggle|resume|enable|disable"
        echo "  status|mode rule|log [n]|version|panel"
        ;;
esac
