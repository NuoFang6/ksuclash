#!/system/bin/sh
# clashctl - 兼容薄壳：转发到 suclash_helper 二进制
#
# 历史上这里是 900 行 shell（awk patch / nc 手写 HTTP / pgrep 探测 / sleep 看门狗），
# 已全部收编进 bin/suclash_helper（Go，单二进制，多架构）。保留此入口的原因：
# APK（Root.SCRIPT）、通知按钮、磁贴、panel.js 的 ksu.exec 均以
# "sh /data/adb/modules/suclash/scripts/clashctl <cmd>" 形式调用，调用方零改动。
#
# 子命令与输出格式由 suclash_helper 保持兼容（status 的 state=/pid=/tun= 等被 APK 解析）。

MODDIR="/data/adb/modules/suclash"
HELPER="$MODDIR/bin/suclash_helper"

# 权限兜底：安装器/zip 可能丢失可执行位
[ -x "$HELPER" ] || chmod 755 "$HELPER" 2>/dev/null

exec "$HELPER" "$@"
