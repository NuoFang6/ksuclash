+func injectHead(body, inject []byte) []byte {
+	if len(inject) == 0 {
+		return body
+	}
+	lower := bytes.ToLower(body)
+	at := -1
+	for _, tag := range []string{"<head", "<html"} {
+		i := bytes.Index(lower, []byte(tag))
+		if i < 0 {
+			continue
+		}
+		if j := bytes.IndexByte(lower[i:], '>'); j >= 0 {
+			at = i + j + 1
+			break
+		}
+	}
+	if at < 0 {
+		return append(append(make([]byte, 0, len(inject)+len(body)), inject...), body...)
+	}
+	out := make([]byte, 0, len(body)+len(inject))
+	out = append(out, body[:at]...)
+	out = append(out, inject...)
+	out = append(out, body[at:]...)
+	return out
+}
