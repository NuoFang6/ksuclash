+// insertBefore 在最后一个 mark 之前插入 inject；找不到 mark 则追加到末尾。
+func insertBefore(body, mark, inject []byte) []byte {
+	i := bytes.LastIndex(body, mark)
+	if i < 0 {
+		return append(body, inject...)
+	}
+	out := make([]byte, 0, len(body)+len(inject))
+	out = append(out, body[:i]...)
+	out = append(out, inject...)
+	out = append(out, body[i:]...)
+	return out
 }
 
