+++ b/hub/route/ui_storage.go
@@ -0,0 +1,109 @@
+package route
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+
+	"github.com/metacubex/chi"
+	"github.com/metacubex/chi/render"
+	"github.com/metacubex/http"
+)
+
+// SU Clash 模块级面板设置：把 external-ui（zashboard）的 localStorage 落到模块数据目录，
+// 使 SU Clash App / 浏览器 / WebUI 等所有入口共用同一份设置，清除或重装 App 都不会丢失。
+//
+// 存储文件与 external-ui 目录同级（线上为 /data/adb/suclash/ui-storage.json）：
+// 刻意不放进 ui 目录本身，避免官方「升级面板」POST /upgrade/ui 清空目录时被一并删除。
+//
+// 读写两端（均需鉴权，与 /ui 之外的其它 API 一致）：
+//   - GET /suclash/ui-storage  面板页面加载时由服务端内联快照（见 injectStorageBridge）
+//   - PUT /suclash/ui-storage  面板改动后由注入脚本 debounce 回写
+//
+// 之所以由服务端内联快照而不是页面自己 GET：localStorage 是同步 API，
+// 面板脚本在求值阶段就会同步读取，异步拉取会让设置全部读空。
+
+const uiStorageMaxBytes = 8 << 20 // 8MB，远超面板设置规模，仅防异常写入
+
+var uiStorageMu sync.Mutex
+
+// uiStorageFile 返回存储文件路径；external-ui 未配置时返回空串（功能自动关闭）。
+func uiStorageFile() string {
+	if uiPath == "" {
+		return ""
+	}
+	return filepath.Join(filepath.Dir(uiPath), "ui-storage.json")
+}
+
+// readUIStorage 返回存储内容与「是否首次启用」（文件尚不存在）。
+// 首次启用时页面会把当前环境的原生 localStorage 迁移上来，避免老用户升级后丢设置。
+func readUIStorage() (map[string]string, bool) {
+	p := uiStorageFile()
+	if p == "" {
+		return map[string]string{}, false
+	}
+	b, err := os.ReadFile(p)
+	if err != nil {
+		return map[string]string{}, os.IsNotExist(err)
+	}
+	m := map[string]string{}
+	if err := json.Unmarshal(b, &m); err != nil || m == nil {
+		return map[string]string{}, false
+	}
+	return m, false
+}
+
+// writeUIStorage 原子写回（临时文件 + rename），避免写一半时进程被杀导致设置全丢。
+func writeUIStorage(m map[string]string) error {
+	p := uiStorageFile()
+	if p == "" {
+		return errors.New("external-ui is not configured")
+	}
+	b, err := json.MarshalIndent(m, "", "  ")
+	if err != nil {
+		return err
+	}
+	uiStorageMu.Lock()
+	defer uiStorageMu.Unlock()
+	tmp := p + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o600); err != nil {
+		return err
+	}
+	if err := os.Rename(tmp, p); err != nil {
+		_ = os.Remove(tmp)
+		return err
+	}
+	return nil
+}
+
+func getUIStorage(w http.ResponseWriter, r *http.Request) {
+	m, fresh := readUIStorage()
+	render.JSON(w, r, render.M{"data": m, "fresh": fresh})
+}
+
+func putUIStorage(w http.ResponseWriter, r *http.Request) {
+	var m map[string]string
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, uiStorageMaxBytes)).Decode(&m); err != nil {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, newError(err.Error()))
+		return
+	}
+	if m == nil {
+		m = map[string]string{}
+	}
+	if err := writeUIStorage(m); err != nil {
+		render.Status(r, http.StatusInternalServerError)
+		render.JSON(w, r, newError(err.Error()))
+		return
+	}
+	render.NoContent(w, r)
+}
+
+func uiStorageRouter() http.Handler {
+	r := chi.NewRouter()
+	r.Get("/", getUIStorage)
+	r.Put("/", putUIStorage)
+	return r
+}
